# Server-side Gemini vision integration
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# Required for public production scans. The detector fails closed without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configure these before enabling saved scans, auth, and direct photo uploads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
